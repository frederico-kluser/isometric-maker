# sem barra final de propósito: em worktree o node_modules costuma ser um SYMLINK
# para o do repositório principal, e `node_modules/` só casaria diretório de verdade.
node_modules
dist/
*.log
.env
.env.*
!.env.example
# artefatos brutos do PixelLab: grandes, reconstruíveis pelo lockfile
tools/pixellab-pipeline/.cache/
# estado de fila e ledger: local, não versionado
tools/pixellab-pipeline/.pixellab/queue-state.json

# arte gerada pelo estúdio: reconstruível a partir de studio.json
tools/character-builder/assets/

# tokens de validação das skills: efêmeros por design (TTL de 30 min).
# Versioná-los transformaria "eu validei agora" em "alguém validou um dia".
.agents/skills/.validation/

# plano de tarefa do router: descartável, apagado ao fim de cada tarefa
TASK_PLAN.md

.pi/

.omo/
